{
  "expo": {
    "name": "ForgetMeNot AI",
    "slug": "forgetmenot-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forgetmenot-ai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forgetmenot.ai"
    },
    "android": {
      "package": "com.forgetmenot.ai"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "046a9792-9fce-4c5e-9f23-d39c39fb388e"
      }
    }
  }
}
